# Postgres (docker compose publishes it on 127.0.0.1:5434).
DATABASE_URL=postgres://skinr:skinr@127.0.0.1:5434/skinr

# Where the API listens; the frontend dev proxy reads AXUM_URL to reach it.
BIND_ADDR=127.0.0.1:3100
AXUM_URL=http://127.0.0.1:3100

RUST_LOG=info

# sde_import: reseed even when the latest SDE build is already in the database.
SDE_FORCE=0

# The game client's CDNs behind /cdn (tests point these at mocks).
# CDN_BINARIES_URL=https://binaries.eveonline.com
# CDN_RESOURCES_URL=https://resources.eveonline.com
# Where the API keeps game files it fetched (shared with the thumbnail script's CACHE).
# CDN_CACHE_DIR=storage/cdn-cache

# ESI (CCP's API). The API syncs the Paragon Hub's SKINR designs every 10 minutes.
# Identify the app to CCP; add a contact, e.g. "skinr.space/0.1 (you@example.com)".
# ESI_USER_AGENT=skinr.space/0.1
# ESI_SYNC=0 turns the sync off (one process per database should run it).
# ESI_URL=https://esi.evetech.net

# Log in with EVE. Register an app at https://developers.eveonline.com with
# the scope esi.cosmetic.char:read and this callback URL (it goes through the
# site's own origin to the API). Login stays off until all three are set.
# Keep the secret out of git.
# EVE_CLIENT_ID=
# EVE_CLIENT_SECRET=
# EVE_CALLBACK_URL=https://skinr-space.test/eve/callback
# EVE_SSO_URL=https://login.eveonline.com

# The server the Rust tests create their throwaway databases on.
# TEST_DATABASE_URL=postgres://skinr:skinr@127.0.0.1:5434/postgres

# The site's origin, for the sitemap's absolute URLs (https://skinr.space in production).
# PUBLIC_ORIGIN=https://skinr-space.test

# The render worker (cd frontend && API=http://127.0.0.1:3100 node scripts/render-server.ts)
# draws the ship thumbnails, which the API keeps current in THUMBNAILS_DIR
# (THUMBNAIL_SYNC=0 stops that), and the Open Graph cards' liveries (/og);
# without it nothing is drawn and cards show the ship thumbnail. Cards and
# renders are kept in OG_CACHE_DIR.
# RENDERER_URL=http://127.0.0.1:3200
# THUMBNAIL_SYNC=1
# Drawings the API keeps in flight; match the worker's WORKERS (compose sets
# both from RENDER_WORKERS).
# THUMBNAIL_CONCURRENCY=1
# THUMBNAILS_DIR=storage/thumbnails

# Debug tools, for the API (/api/debug) and the frontend (a button by a ship's
# skin that draws that livery's thumbnails). They start renders on request:
# never in production. On in docker compose.
# DEBUG_TOOLS=1
# OG_CACHE_DIR=storage/og
# IMAGE_SERVER_URL=https://images.evetech.net
