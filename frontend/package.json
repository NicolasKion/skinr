{
  "name": "skinr-frontend",
  "version": "0.0.1",
  "private": true,
  "license": "MIT",
  "type": "module",
  "imports": {
    "#lib/*": "./src/lib/*"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test:unit": "vitest",
    "test": "npm run test:unit -- --run",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@carbonenginejs/runtime": "^0.1.0-alpha.12",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@lucide/svelte": "^1.67.0",
    "@playwright/test": "^1.64.1",
    "@sveltejs/adapter-node": "^6.0.1",
    "@sveltejs/kit": "^3.1.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.4",
    "@types/node": "^26.6.6",
    "@vitest/browser-playwright": "^5.1.0",
    "bits-ui": "^2.20.4",
    "clsx": "^2.1.1",
    "embla-carousel-svelte": "^8.6.0",
    "oxfmt": "^0.76.0",
    "oxlint": "^1.91.0",
    "playwright": "^1.64.1",
    "shadcn-svelte": "^1.7.2",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "svelte-sonner": "^1.2.3",
    "tailwind-merge": "^3.7.0",
    "tailwind-variants": "^4.0.1",
    "tailwindcss": "^4.3.4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vitest": "^5.1.0",
    "vitest-browser-svelte": "^3.1.0",
    "webgpu": "^0.6.2"
  },
  "overrides": {
    "runed": {
      "@sveltejs/kit": "$@sveltejs/kit"
    }
  },
  "allowScripts": {
    "webgpu": false
  }
}
